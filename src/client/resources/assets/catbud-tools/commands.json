    "usage": "/config [資訊功能] [true/def/false]",
    "description": ["設定玩家資訊顯示功能"],
    "tag": "GUI",
    "subcommands": {
      "*": {
        "tag": "config"
      }
    }
  },
  "countries": {
    "usage": "/countries",
    "description": ["查看所有玩家使用的語言(遊戲設置)"]
  },
  "detached": {
    "usage": "/detached",
    "description": ["查看當前區塊有多少隻生物被分離"]
  },
  "enchant": {
    "usage": "/enchant",
    "description": ["查看貓芽特殊附魔列表"],

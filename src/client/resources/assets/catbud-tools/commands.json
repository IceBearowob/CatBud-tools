{
  "adless": {
    "usage": "/adless [操作類型]",
    "description": [
      "屏蔽廣告相關指令，",
      "直接輸入可以延長屏蔽廣告時間(與/adless extend功能相同)"
    ],
    "subcommands": {
      "clear": {
        "usage": "/adless clear",
        "description": ["清除屏蔽廣告時間"]
      },
      "extend": {
        "usage": "/adless extend",
        "description": ["延長屏蔽廣告時間"]
      },
      "left": {
        "usage": "/adless left",
        "description": ["查看屏蔽廣告剩餘時間"]
      }
    }
  },
  "ark": {
    "usage": "/ark <方舟參數>",
    "description": ["跟方舟生存有關的指令"],
    "subcommands": {
      "quit": {
        "usage": "/ark quit",
        "description": [
          "離開方舟生存",
          "只能在方舟生存模式內才有效"
        ]
      },
      "ranks": {
        "usage": "/ark ranks",
        "description": ["查詢方舟單人最快通過排名"]
      },
      "review": {
        "usage": "/ark review <UUID>",
        "description": ["方舟回顧功能，UUID可以在方舟通關後看到"]
      }
    }
  },
  "award": {
    "usage": "/award [賽季]",
    "description": ["查看賽季抵達王者牌位結算後的獎勵"],
    "tag": "GUI"
  },
  "ban-day": {
    "usage": "/ban-day <Minecraft ID> <天數(1/3/9)> <原因>",
    "description": ["將玩家以特定天數ban掉(只有R/SR/SSR的天數選項)"],
    "tag": "OP"
  },
  "beacon": {
    "usage": "/beacon [操作類型]",
    "description": ["與信標有關的指令"],
    "tag": "GUI",
    "subcommands": {
      "add": {
        "usage": "/beacon add <信標名稱>",
        "description": ["新增信標"]
      },
      "buy": {
        "usage": "/beacon buy",
        "description": ["購買信標容量"]
      },
      "capacity": {
        "usage": "/beacon capacity",
        "description": ["查詢當前信標容量"]
      },
      "go": {
        "usage": "/beacon go <目標信標名稱>",
        "description": ["傳送到信標的位置"]
      },
      "icon": {
        "usage": "/beacon icon <目標信標名稱> <圖標>",
        "description": ["修改信標在GUI的顯示圖標"]
      },
      "note": {
        "usage": "/beacon note <目標信標名稱> [備註]",
        "description": ["為信標新增或修改備註"]
      },
      "page": {
        "usage": "/beacon page <信標頁數>",
        "description": ["開啟特定頁數的信標GUI"]
      },
      "remove": {
        "usage": "/beacon remove <目標信標名稱>",
        "description": ["刪除信標"]
      },
      "rename": {
        "usage": "/beacon rename <目標信標名稱> <目標信標改名名稱>",
        "description": ["信標改名"]
      },
      "total": {
        "usage": "/beacon total",
        "description": ["查詢當前信標總數"]
      },
      "track": {
        "usage": "/beacon track <目標信標位置>",
        "description": ["追蹤信標的位置(顯示在畫面上)"]
      },
      "untrack": {
        "usage": "/beacon untrack <目標信標位置>",
        "description": ["取消追蹤信標的位置"]
      }
    }
  },
  "broadcast": {
    "usage": "/broadcast <廣播操作參數>",
    "description": ["廣播用的指令"],
    "tag": "OP",
    "subcommands": { 
      "clear": {
        "usage": "/broadcast clear",
        "description": ["結束廣播循環"]
      },
      "set": {
        "usage": "/broadcast set <廣播速度參數> <廣播訊息參數>",
        "description": [
          "根據設定的內容與速度開始廣播循環",
          "fastest:2分鐘;fast:5分鐘;normal:10分鐘;slow:20分鐘;slowest:30分鐘"
        ]
      }
    }
  },
  "buff": {
    "usage": "/buff [輔助功能] [true/false/def]",
    "description": ["設定輔助功能"],
    "tag": "GUI",
    "subcommands": {
      "*": {
        "tag": "buff"
      }
    }
  },
  "code": {
    "usage": "/code <禮品代碼>",
    "description": ["可以兌換code獲得貓幣"],
    "subcommands": { 
      "*": {
        "subcommands": {
          "add": {
            "usage": "/code <禮品代碼> add <禮品金額> <有效天數>",
            "description": ["新增禮品代碼"],
            "tag": "OP"
          },
          "remove": {
            "usage": "/code <禮品代碼> remove",
            "description": ["刪除禮品代碼"],
            "tag": "OP"
          },
          "status": {
            "usage": "/code <禮品代碼> status",
            "description": ["查看禮品代碼的使用狀態"],
            "tag": "OP"
          }
        }
      }
    }
  },
  "coin": {
    "usage": "/coin [操作類型]",
    "description": ["與課金有關的指令"],
    "tag": "GUI",
    "subcommands": { 
      "buy": {
        "usage": "/coin buy <目標份量參數> <電子郵件>",
        "description": ["購買特定分量的貓幣"]
      },
      "log": {
        "usage": "/coin log",
        "description": ["查詢購買紀錄"]
      }
    }
  },
  "config": {
    "usage": "/config [資訊功能] [true/false/def]",
    "description": ["設定玩家資訊顯示功能"],
    "tag": "GUI",
    "subcommands": {
      "*": {
        "tag": "config"
      }
    }
  },
  "special": {
    "usage": "/special <參數>",
    "description": ["獲得特殊物品或召喚特殊實體的指令"],
    "tag": "OP",
    "subcommands": {
      "item": {
        "usage": "/special item <物品>",
        "description": ["獲得特殊物品"],
        "subcommands": {
          "*": {
            "tag": "special_item"
          }
        }
      },
      "entity": {
        "usage": "/special entity <實體>",
        "description": ["召喚特殊實體"],
        "subcommands": {
          "*": {
            "tag": "special_entity"
          }
        }
      }
    }
  },
  "to": {
    "usage": "/to <傳送操作類型>",
    "description": ["公傳點的系列指令"],
    "subcommands": {
      "set": {
        "usage": "/to set",
        "description": ["在當前座標設置公傳點"]
      },
      "clear": {
        "usage": "/to clear",
        "description": ["移除公傳點"]
      },
      "by": {
        "usage": "/to by <玩家ID>",
        "description": ["傳送到玩家的公傳點"]
      }
    }
  },
  "room": {
    "usage": "/room <房間參數>",
    "description": ["房間的系列指令"],
    "subcommands": {
      "config": {
        "usage": "/room config [配置類型]",
        "description": ["調整當前選擇模式相關的配置類型，"],
        "tag": "GUI",
        "subcommands": {
          "enter": {
            "usage": "/room config enter",
            "description": ["直接無視任何條件進入模式內"]
          },
          "script": {
            "usage": "/room config script <腳本參數>",
            "description": ["設定腳本(怪物類型、場地)"],
            "subcommands": {
              "auditorium_0": {
                "usage": "/room config script auditorium_0",
                "description": ["強制進入場地\"教堂\""],
                "tag": "OP"
              },
              "basement_0": {
                "usage": "/room config script basement_0",
                "description": ["強制進入場地\"車站\""],
                "tag": "OP"
              },
              "dungeon_0": {
                "usage": "/room config script dungeon_0",
                "description": ["強制進入場地\"地下城\""],
                "tag": "OP"
              },
              "slime_0": {
                "usage": "/room config script slime_0",
                "description": ["強制進入場地並指定緊急boss\"史萊姆\""],
                "tag": "OP"
              },
              "breeze_0": {
                "usage": "/room config script breeze_0",
                "description": ["強制進入場地並指定緊急boss\"旋風使者\""],
                "tag": "OP"
              },
              "random": {
                "usage": "/room config script random",
                "description": ["隨機選擇"]
              },
              "icebear": {
                "usage": "/room config script icebear",
                "description": ["將天界boss設定為\"冰熊\""]
              },
              "systemcat": {
                "usage": "/room config script systemcat",
                "description": ["將天界boss設定為\"系統貓\""]
              },
              "tangair": {
                "usage": "/room config script tangair",
                "description": ["將天界boss設定為\"會長\""]
              }
            }
          },
          "difficulty": {
            "usage": "/room config difficulty",
            "description": [
              "選擇難度",
              "very_low:超簡單;low:簡單;medium:普通;high:困難;very_high:超困難"
            ]
          },
          "skip": {
            "usage": "/room config skip",
            "description": ["可以跳過階段(波次)"],
            "tag": "OP"
          },
          "channel": {
            "usage": "/room config channel <分流編號參數>",
            "description": ["選擇要列隊的分流"]
          },
          "execute": {
            "usage": "/room config execute",
            "description": ["可以強制讓所有列隊的玩家進入場地"],
            "tag": "OP"
          },
          "exit": {
            "usage": "/room config exit",
            "description": ["強制離開模式"],
            "tag": "OP"
          },
          "terrain": {
            "usage": "/room config terrain <目標場地參數>",
            "description": ["選擇場地(其實就是地圖)"],
            "subcommands": {
              "castle_0": {
                "usage": "/room config terrain castle_0",
                "description": ["強制進入場地"],
                "tag": "OP"
              },
              "countryside_0": {
                "usage": "/room config terrain countryside_0",
                "description": ["強制進入場地"],
                "tag": "OP"
              },
              "random": {
                "usage": "/room config terrain random",
                "description": ["隨機選擇"]
              },
              "medium_dungeon": {
                "usage": "/room config terrain medium_dungeon",
                "description": ["選擇場地\"中型地下城\""]
              },
              "sky_ruins": {
                "usage": "/room config terrain sky_ruins",
                "description": ["選擇場地\"天空遺跡\""]
              },
              "spaceship": {
                "usage": "/room config terrain spaceship",
                "description": ["選擇場地\"太空船\""]
              },
              "stone_pillars": {
                "usage": "/room config terrain stone_pillars",
                "description": ["選擇場地\"石柱簇\""]
              }
            }
          },
          "layer": {
            "usage": "/room config layer <目標層數參數>",
            "description": ["在魔塔內使用可以直接前往指定樓層"],
            "tag": "OP"
          },
          "return": {
            "usage": "/room config return",
            "description": [
              "在王者戰爭或爭奪貓盃中使用，",
              "可以強制讓已經變成觀察者的玩家回歸遊玩"
            ],
            "tag": "OP"
          }
        }
      },
      "capacity": {
        "usage": "/room capacity",
        "description": ["查詢當前房間最大可容納人數"]
      },
      "exit": {
        "usage": "/room exit",
        "description": ["離開當前房間"]
      },
      "invite": {
        "usage": "/room invite <目標玩家參數>",
        "description": ["邀請玩家加入房間"]
      },
      "join": {
        "usage": "/room join <UUID>",
        "description": ["加入房間"]
      },
      "kick": {
        "usage": "/room kick <目標玩家參數>",
        "description": ["從當前房間踢出玩家"]
      },
      "members": {
        "usage": "/room members",
        "description": ["查看當前房間成員"]
      },
      "mode": {
        "usage": "/room mode <模式參數>",
        "description": ["切換房間模式"],
        "subcommands": {
          "*": {
            "tag": "mode"
          }
        }
      },
      "queue": {
        "usage": "/room queue",
        "description": ["開始列隊"]
      },
      "stop": {
        "usage": "/room stop",
        "description": ["結束列隊"]
      },
      "total": {
        "usage": "/room total",
        "description": ["查詢當前房間的人數"]
      },
      "transfer": {
        "usage": "/room transfer <目標玩家參數>",
        "description": ["轉交房主給玩家"]
      },
      "waiting": {
        "usage": "/room waiting",
        "description": ["查詢當前選擇模式的列隊人數"]
      }
    }
  },
  "example": {
    "usage": "",
    "description": [],
    "subcommands": { 
      "example": {
        "usage": "",
        "description": []
      }
    }
  }
}

      "page": {
        "usage": "/land page <頁數>",
        "description": ["開啟特定頁數的領地GUI"]
      },
      "remove": {
        "usage": "/land remove <目標座標參數>",
        "description": ["刪除領地"]
      },
      "total": {
        "usage": "/land total",
        "description": ["查詢當前領地總數"]
      },
      "track": {
        "usage": "/land track <目標座標參數>",
        "description": ["追蹤領地的位置(顯示在畫面上)"]
      },
      "untrack": {
        "usage": "/land untrack <目標座標參數>",
        "description": ["取消追蹤領地的位置"]
      }
    }

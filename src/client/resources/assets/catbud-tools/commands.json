{
  "adless": {
    "usage": "/adless [操作類型]",
    "description": [
      "屏蔽廣告相關指令，",
      "直接輸入可以延長屏蔽廣告時間(與/adless extend功能相同)"
    ],
    "subcommands": {
      "clear": {
        "usage": "/adless clear",
        "description": ["清除屏蔽廣告時間"]
      },
      "extend": {
        "usage": "/adless extend",
        "description": ["延長屏蔽廣告時間"]
      },
      "left": {
        "usage": "/adless left",
        "description": ["查看屏蔽廣告剩餘時間"]
      }
    }
  },
  "ark": {
    "usage": "/ark <方舟參數>",
    "description": ["跟方舟生存有關的指令"],
    "subcommands": {
      "quit": {
        "usage": "/ark quit",
        "description": [
          "離開方舟生存",
          "只能在方舟生存模式內才有效"
        ]
      },
      "ranks": {
        "usage": "/ark ranks",
        "description": ["查詢方舟單人最快通過排名"]
      },
      "review": {
        "usage": "/ark review <UUID>",
        "description": ["方舟回顧功能，UUID可以在方舟通關後看到"]
      }
    }
  },
  "award": {
    "usage": "/award [賽季]",
    "description": ["查看賽季抵達王者牌位結算後的獎勵"],
    "tag": "GUI"
  },
  "ban-day": {
    "usage": "/ban-day <目標玩家參數> <天數(1/3/9)> <原因>",
    "description": ["將玩家以特定天數ban掉(只有R/SR/SSR的天數選項)"],
    "tag": "OP"
  },
  "beacon": {
    "usage": "/beacon [操作類型]",
    "description": ["與信標有關的指令"],
    "tag": "GUI",
    "subcommands": {
      "add": {
        "usage": "/beacon add <信標名稱>",
        "description": ["新增信標"]
      },
      "buy": {
        "usage": "/beacon buy",
        "description": ["購買信標容量"]
      },
      "capacity": {
        "usage": "/beacon capacity",
        "description": ["查詢當前信標容量"]
      },
      "go": {
        "usage": "/beacon go <目標信標名稱>",
        "description": ["傳送到信標的位置"]
      },
      "icon": {
        "usage": "/beacon icon <目標信標名稱> <圖標>",
        "description": ["修改信標在GUI的顯示圖標"]
      },
      "note": {
        "usage": "/beacon note <目標信標名稱> [備註]",
        "description": ["為信標新增或修改備註"]
      },
      "page": {
        "usage": "/beacon page <信標頁數>",
        "description": ["開啟特定頁數的信標GUI"]
      },
      "remove": {
        "usage": "/beacon remove <目標信標名稱>",
        "description": ["刪除信標"]
      },
      "rename": {
        "usage": "/beacon rename <目標信標名稱> <目標信標改名名稱>",
        "description": ["信標改名"]
      },
      "total": {
        "usage": "/beacon total",
        "description": ["查詢當前信標總數"]
      },
      "track": {
        "usage": "/beacon track <目標信標位置>",
        "description": ["追蹤信標的位置(顯示在畫面上)"]
      },
      "untrack": {
        "usage": "/beacon untrack <目標信標位置>",
        "description": ["取消追蹤信標的位置"]
      }
    }
  },
  "broadcast": {
    "usage": "/broadcast <廣播操作參數>",
    "description": ["廣播用的指令"],
    "tag": "OP",
    "subcommands": { 
      "clear": {
        "usage": "/broadcast clear",
        "description": ["結束廣播循環"]
      },
      "set": {
        "usage": "/broadcast set <廣播速度參數> <廣播訊息參數>",
        "description": [
          "根據設定的內容與速度開始廣播循環",
          "fastest:2分鐘;fast:5分鐘;normal:10分鐘;slow:20分鐘;slowest:30分鐘"
        ]
      }
    }
  },
  "buff": {
    "usage": "/buff [輔助功能] [true/def/false]",
    "description": ["設定輔助功能"],
    "tag": "GUI",
    "subcommands": {
      "*": {
        "tag": "buff"
      }
    }
  },
  "code": {

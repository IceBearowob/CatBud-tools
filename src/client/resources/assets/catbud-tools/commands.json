          },
          "status": {
            "usage": "/code <禮品代碼> status",
            "description": ["查看禮品代碼的使用狀態"],
            "tag": "OP"
          }
        }
      }
    }
  },
  "coin": {
    "usage": "/coin [操作類型]",
    "description": ["與課金有關的指令"],
    "tag": "GUI",
    "subcommands": { 
      "buy": {
        "usage": "/coin buy <目標份量參數> <電子郵件>",

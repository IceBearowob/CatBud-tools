  },
  "erase": {
    "usage": "/erase <選中半徑>",
    "description": [
      "以半徑x格將範圍內的實體移除",
      "玩家不受影響",
      "半徑只能在0.0~99.9之間"
    ],
    "tag": "OP"
  },
  "event": {
    "usage": "/event [活動操作類型]",
    "description": [
      "與活動有關的指令",
      "直接輸入可以前往活動，與/event go效果相同"
    ],
    "subcommands": { 
      "clear": {
        "usage": "/event clear",
        "description": ["清除當前活動"],
        "tag": "OP"
      },
      "go": {
        "usage": "/event go",
        "description": ["前往活動"]
      },
      "set": {
        "usage": "/event set <設定類型>",
        "description": ["設定活動傳送點"],
        "tag": "OP",
        "subcommands": {
          "current": {
            "usage": "/event set current",
            "description": ["將當前地點設為活動傳送點"]
          },
          "server": {
            "usage": "/event set server <伺服器名稱>",
            "description": [
              "將伺服器設為活動傳送點",
              "設置後玩家會傳送到指定的伺服器",
              "伺服器名稱只能是貓芽內的(tester/main)，其他沒效果"
            ]
          },
          "transfer": {
            "usage": "/event set transfer <伺服器地址>",
            "description": [
              "將伺服器位址設為活動傳送點",
              "Port固定25565",
              "效果等於原版的/transfer指令"
            ]
          }
        }
      }
    }
  },
